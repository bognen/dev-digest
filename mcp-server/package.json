{
  "name": "@devdigest/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP server exposing the DevDigest API to coding agents",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector@2.9.0 node node_modules/tsx/dist/cli.mjs src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
